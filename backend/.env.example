# ==========================================
# Backend Environment Configuration
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# Database (Use ONE of the following)
# Option 1: EC2 Hosted MongoDB (Production/Development)
MONGODB_URI=mongodb://13.235.248.212:27017/finance_leads
# Option 2: Local MongoDB (Development only)
# MONGODB_URI=mongodb://127.0.0.1:27017/finance_leads
# Option 3: MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/finance_leads?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRE=30d

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# CORS - Allowed origins (comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LEAD_RATE_LIMIT_WINDOW_MS=3600000
LEAD_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=debug
